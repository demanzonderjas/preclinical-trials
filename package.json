{
	"name": "pct",
	"private": true,
	"type": "module",
	"description": "PreclinicalTrials.eu frontend: Inertia + React 19, built with Vite. The legacy SPA lives in resources/legacy.",
	"scripts": {
		"dev": "vite",
		"build": "node scripts/export-protocol-schema.mjs --check && tsc --noEmit && vite build && vite build --ssr",
		"typecheck": "tsc --noEmit",
		"export-schema": "node scripts/export-protocol-schema.mjs"
	},
	"dependencies": {
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource-variable/source-sans-3": "^5.3.1",
		"@inertiajs/react": "^3.9.1",
		"@tiptap/extension-image": "^3.32.0",
		"@tiptap/extension-link": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/react": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"clsx": "^2.1.1",
		"lucide-react": "^1.58.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@inertiajs/vite": "^3.9.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"d3-geo": "^3.1.1",
		"laravel-vite-plugin": "^3.2.0",
		"tailwindcss": "^4.3.3",
		"topojson-client": "^3.1.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"world-atlas": "^2.0.2"
	}
}
