APP_NAME=PreclinicalTrials.eu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pct
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Required: Symfony Mailer refuses to send without a sender.
MAIL_FROM_ADDRESS=info@preclinicaltrials.eu
MAIL_FROM_NAME="${APP_NAME}"

# Receives submissions, embargo requests and contact form messages.
ADMIN_MAIL=

# Shared secrets of the external integrations (routes/api.php).
ILES_TOKEN=
EXTERNAL_API_KEY=

# Translation of French APAFiS imports.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
