{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["vite/client", "node"],
		"paths": { "@/*": ["./resources/js/*"] }
	},
	"include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "vite.config.ts"]
}
