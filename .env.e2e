# Environment for the end-to-end suite (tests/e2e). Loaded when APP_ENV=e2e.
# The mailer and queue are forced by App\Providers\E2EServiceProvider, which also reuses the
# MySQL host and credentials from your normal .env, so only the database name lives here.
# The APP_KEY below is a throwaway key for test data only.
APP_NAME=PreclinicalTrials.eu
APP_ENV=e2e
APP_KEY=base64:gbfXualGC2a4mkU1r8TCZteu+Sv4bUQBh0gesH13BAE=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=single
DB_CONNECTION=mysql
DB_DATABASE=pct_e2e
SESSION_DRIVER=file
CACHE_DRIVER=file
MAIL_MAILER=array
QUEUE_CONNECTION=sync
ADMIN_MAIL=admin-inbox@pct.test
ILES_TOKEN=e2e-iles-token
EXTERNAL_API_KEY=e2e-external-key
